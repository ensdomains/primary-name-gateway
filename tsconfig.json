{
	"compilerOptions": {
		"target": "ESNext",
		"module": "Preserve",
		"moduleResolution": "bundler",
		"lib": ["ESNext"],
		"types": ["bun"],
		"strict": true,
		"noEmit": true,
		"skipLibCheck": true,
		"verbatimModuleSyntax": true,
		"noUncheckedIndexedAccess": false,
		"allowImportingTsExtensions": false
	},
	"include": ["packages/*/src/**/*.ts", "test/**/*.ts", "scripts/**/*.ts"]
}
