{
	"name": "primary-name-gateway",
	"private": true,
	"type": "module",
	"workspaces": [
		"packages/shared",
		"packages/registrar-indexer",
		"packages/registrar-gateway"
	],
	"scripts": {
		"check": "tsc",
		"indexer": "bun packages/registrar-indexer/src/index.ts",
		"gateway": "bun packages/registrar-gateway/src/main.ts",
		"forge": "cd packages/contracts && forge build",
		"test": "bun run forge && bun test test/trie.test.ts test/store.test.ts test/linea.test.ts test/offline.test.ts test/offline-base.test.ts test/offline-minage.test.ts test/offline-linea.test.ts && cd packages/contracts && forge test",
		"test:mainnet": "bun run forge && bun test test/mainnet.test.ts",
		"indexer:linea": "INDEXER_CHAIN=linea INDEXER_PORT=8101 bun packages/registrar-indexer/src/index.ts",
		"gateway:linea": "GATEWAY_CHAIN=linea INDEXER_URL=http://localhost:8101 GATEWAY_PORT=8201 bun packages/registrar-gateway/src/main.ts",
		"fixture:linea": "bun scripts/linea-fixture.ts",
		"indexer:base": "INDEXER_CHAIN=base INDEXER_PORT=8102 bun packages/registrar-indexer/src/index.ts",
		"gateway:base": "GATEWAY_CHAIN=base INDEXER_URL=http://localhost:8102 GATEWAY_PORT=8202 bun packages/registrar-gateway/src/main.ts",
		"lint": "biome check",
		"lint:fix": "biome check --write"
	},
	"devDependencies": {
		"@adraffy/blocksmith": "^0.1.60",
		"@biomejs/biome": "2.6.8",
		"@types/bun": "^1.4.5",
		"typescript": "^7.0.2"
	}
}
